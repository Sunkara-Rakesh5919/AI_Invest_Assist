# Backend Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# API KEYS (Get from respective services)
# ============================================================================

# Alpha Vantage - https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Finnhub - https://finnhub.io/
FINNHUB_KEY=your_finnhub_key_here

# RapidAPI - https://rapidapi.com/ (for Yahoo Finance)
RAPID_API_KEY=your_rapidapi_key_here

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port to run the backend server
PORT=5000

# Node environment
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite database file path (relative to backend folder)
DATABASE_PATH=./stock_data.db

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limit per minute (requests per IP)
RATE_LIMIT_PER_MINUTE=30

# Rate limit per 5 minutes (requests per stock symbol)
RATE_LIMIT_PER_5MIN=100

# ============================================================================
# CACHING
# ============================================================================

# Cache duration in minutes
CACHE_DURATION_MINUTES=5

# ============================================================================
# WEBSOCKET
# ============================================================================

# WebSocket update interval in seconds
WS_UPDATE_INTERVAL=30

# Maximum concurrent WebSocket connections
MAX_WS_CONNECTIONS=1000

# ============================================================================
# SECURITY
# ============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5500,https://yourdomain.com

# ============================================================================
# LOGGING
# ============================================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable detailed API call logging
DEBUG_API_CALLS=false
